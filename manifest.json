{
  "manifest_version": 3,
  "name": "FD Table Copier",
  "version": "1.0.0",
  "description": "Copies FD financial table rows as JSON for import.",
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}